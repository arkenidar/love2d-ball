{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug LOVE2D (\"love\" in PATH)",
            "type": "lua-local", // tomblind.local-lua-debugger-vscode
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [
                "${workspaceFolder}"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug LOVE2D (Win. BUNDLED)",
            "type": "lua-local", // tomblind.local-lua-debugger-vscode
            "request": "launch",
            "program": {
                "command": "${workspaceFolder}\\runtime-love2d\\love.exe"
            },
            "args": [
                "${workspaceFolder}"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run C99 Ball Game (SDL3)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/ball_game",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}